# =============================================================================
# users-module local dev environment
# =============================================================================
# Copy to .env and edit. The defaults below are safe for local development;
# override for any non-local deployment.
#
# docker-compose.yml, the API server, and the GUI all read from this file.
# =============================================================================

# ---- Deployment mode --------------------------------------------------------
# Accepted values — any other value is rejected at boot (config.Load fails and
# the process exits; it is never a silent fallback):
#   local           a developer machine or CI checkout. The only mode with
#                   relaxed defaults: an empty CORS_ORIGINS becomes allow-all
#                   (never with credentials). Every other mode denies CORS
#                   by default and rejects "*" in CORS_ORIGINS at boot.
#   serverless      a scale-to-zero runtime (Cloud Run, Lambda). Defaults the
#                   DB connection pool to 4 rather than 20, since many
#                   short-lived instances share one database.
#   k8s             an orchestrated container deployment.
#   container-host  an unorchestrated container deployment: one host running
#                   the stack under a container runtime (Docker, Podman, plain
#                   containerd) with no orchestrator.
#
# The value is also emitted verbatim as the OTel `deployment.environment`
# resource attribute, so set it truthfully. Host applications may key their own
# boot-time guards off it — commonly on `!= local` rather than on a specific
# value, so a non-local mode enables every such guard at once.
DEPLOY_MODE=local

# ---- Postgres ---------------------------------------------------------------
POSTGRES_USER=users
POSTGRES_PASSWORD=users
POSTGRES_DB=users
POSTGRES_PORT=5432
# API reads DB_URL directly. The API also accepts MFAPP_DATABASE_URL as a
# preferred alternative name (checked first; falls back to DB_URL when
# unset) — that is the name the app-mfmanager catalog-deploy engine injects
# into the apps it manages. Both names are supported permanently: this is
# not a rename-in-progress, and neither name is scheduled for removal.
# Self-hosted / non-catalog deployments (including this repo's own
# docker-compose reference stack) should keep using DB_URL directly.
DB_URL=postgresql://users:users@localhost:5432/users?sslmode=disable
# MFAPP_DATABASE_URL=postgresql://users:users@localhost:5432/users?sslmode=disable
# Connection pool. DB_MAX_CONNS defaults to 20 (4 in serverless mode); the
# lifetimes are Go durations.
# DB_MAX_CONNS=20
# DB_MAX_CONN_LIFETIME=5m
# DB_MAX_CONN_IDLE_TIME=1m

# ---- API server -------------------------------------------------------------
SERVER_ADDR=:8080
GUI_BASE_URL=http://localhost:3000
# Comma-separated exact origins. Unset = no CORS headers (outside local mode).
# See docs/cors.md.
CORS_ORIGINS=http://localhost:3000
# Graceful-shutdown deadline (Go duration).
# SERVER_SHUTDOWN_TIMEOUT=25s
# Setup-token display: both (default), stderr, localhost or none. See README
# "First run: setup token, bootstrap, OIDC configuration".
# TOKEN_DISPLAY=both

# OpenTelemetry. The endpoint is empty by default; the service name defaults
# to users-api.
# OTEL_EXPORTER_OTLP_ENDPOINT=
# OTEL_SERVICE_NAME=users-api

# ---- Authelia / OIDC --------------------------------------------------------
# NOTE: for local dev you must add `127.0.0.1  authelia` to /etc/hosts so the
# browser can reach Authelia at the same hostname the API uses. See
# deploy/local/README.md (First-time setup) for the full explanation.
AUTHELIA_PORT=9091

# Secrets must be >= 32 chars. Change these for anything beyond local dev.
AUTHELIA_IDENTITY_VALIDATION_RESET_PASSWORD_JWT_SECRET=change-me-jwt-secret-at-least-32-chars-long
AUTHELIA_SESSION_SECRET=change-me-session-secret-at-least-32-chars
AUTHELIA_STORAGE_ENCRYPTION_KEY=change-me-storage-encryption-key-at-least-32
AUTHELIA_IDENTITY_PROVIDERS_OIDC_HMAC_SECRET=change-me-oidc-hmac-secret-at-least-32

# --- Auth providers ---
# Enable providers by setting their CLIENT_ID/CLIENT_SECRET below.
# Local dev uses Authelia (automatic via docker-compose; the AUTH_PROVIDER_AUTHELIA_*
# values are baked into deploy/local/docker-compose.yml so you don't need to
# set them here unless you want to override the default client secret).
#
# To enable Google in local dev, create a Google Cloud OAuth 2.0 Client
# (https://console.cloud.google.com/apis/credentials) with:
#   - Application type: Web application
#   - Authorized redirect URI: http://localhost:8080/v1/auth/oidc/google/callback
# Then set:
#
# AUTH_PROVIDER_GOOGLE_CLIENT_ID=...apps.googleusercontent.com
# AUTH_PROVIDER_GOOGLE_CLIENT_SECRET=...
#
# Microsoft: you need to register an app with Entra ID:
# https://entra.microsoft.com/ -> 'App registrations' -> 'Register an app'
#
# For the "supported account types" allowed to log in or create an account,
# 'Single tenant - Default Directory' means only users pre-registered through
# Entra ID (or AD?) can use the app. Use 'Any Entra ID Tenant + Personal
# Microsoft Accounts' and anyone with an MS account can access the app.
#
# Set the redirect URL:
# Web / http://localhost:8080/v1/auth/oidc/microsoft/callback
#
# Then ctreate a secret key:
# 'Add a certificate or secret' (from 'Overview') -> 'New client secret'
# 
# Then update the 'AUTH_PROVIDER_MICROSOFT_CLIENT_ID' and '..._CLIENT_SECRET'.
# Note, the '..._CLIENT_ID' is the tenant ID (not what MS calls the 
# app/client ID) and the '..._CLIENT_SECRET' is the secret key value. 
#
# The '...ISSUER_URL' depends on what you choose; for a single tenant, it will
# be:
# https://login.microsoftonline.com/{ tenant ID }/v2.0
# For multi-tenant:
# https://login.microsoftonline.com/common/v2.0 (which is the default)
#
# For any non-well-known provider (e.g. self-hosted Keycloak), all fields
# must be set explicitly:
#   AUTH_PROVIDER_<ID>_DISPLAY_NAME=...
#   AUTH_PROVIDER_<ID>_ISSUER_URL=...
#   AUTH_PROVIDER_<ID>_CLIENT_ID=...
#   AUTH_PROVIDER_<ID>_CLIENT_SECRET=...
#   AUTH_PROVIDER_<ID>_CLAIM_STYLE=<google|microsoft|authelia|generic|...>
#   AUTH_PROVIDER_<ID>_SCOPES=openid,email,profile   # optional
#
# AUTH_PROVIDERS may be set to a comma-separated allowlist of provider IDs;
# if unset, providers are auto-discovered from any AUTH_PROVIDER_<ID>_CLIENT_ID
# that is non-empty.

# Override the local Authelia client secret (must match the hash committed in
# deploy/local/authelia/configuration.yml). Defaults to "local-authelia-secret".
# AUTH_PROVIDER_AUTHELIA_CLIENT_SECRET=local-authelia-secret

# URLs used by the OAuth flow (only needed if any provider is enabled).
AUTH_OAUTH_REDIRECT_BASE_URL=http://localhost:8080
AUTH_FRONTEND_RETURN_URL=http://localhost:3000/auth/oidc/return

# Public base path of the API when a proxy strips the mount prefix (e.g.
# /manage). Sets the oidc_state cookie Path to <base>/v1/auth/oidc/. Leave unset
# to derive it from the request. See docs/cookie-path.md.
# USERS_COOKIE_PATH=/manage

# ---- Local auth (non-OIDC) --------------------------------------------------
LOCAL_ISSUER=users-module-local

# Access tokens are EdDSA (Ed25519) JWTs that carry a server-side session (or a
# non-interactive credential); the session is re-checked on every request.
# See docs/jwt-eddsa.md.
#
# Ed25519 private key, PKCS#8 PEM ("-----BEGIN PRIVATE KEY-----"); literal \n
# is accepted for newlines. Optional: when unset, a key is generated on first
# boot and persisted in mod_users.auth_signing_keys (zero-config local dev).
# Set it explicitly in production. Generate with:
#   openssl genpkey -algorithm ed25519
# JWT_SIGNING_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
# Optional "kid" header value for issued tokens (printable ASCII, <=128 bytes).
# JWT_SIGNING_KID=2026-10
# Extra public keys accepted for verification (rotation / verify-only use):
# one PKIX PEM ("-----BEGIN PUBLIC KEY-----"), or a JSON object kid -> PEM.
# JWT_VERIFY_PUBLIC_KEYS='{"2026-04":"-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"}'
# Optional explicit HMAC key for the OAuth state parameter only; when unset it
# is derived from the signing key (an explicit value wins).
# JWT_SECRET=change-me-oauth-state-key-at-least-32-chars

# Access-token and session lifetimes (Go durations; defaults shown).
# AUTH_ACCESS_TOKEN_TTL=1h            # at most 1h; exp never outlives the session
# AUTH_SESSION_MAX_AGE=720h           # absolute session lifetime
# AUTH_SESSION_IDLE_TIMEOUT=168h      # refresh-lineage expiry
# AUTH_CLIENT_CREDENTIALS_TTL=15m     # client-credentials access tokens
# AUTH_IMPERSONATION_TTL=30m          # one impersonation token / renewal
# AUTH_IMPERSONATION_MAX=60m          # total impersonation from its start
# AUTH_SELF_SERVICE_MAX_AUTH_AGE=10m  # auth_time freshness for self-service changes

# Token audiences. AUTH_DEFAULT_AUDIENCE is the "aud" of a token whose session
# has no app. AUTH_ACCEPTED_AUDIENCES (comma-separated) restricts the "aud"
# values bearer tokens may carry; when unset, the default audience plus any
# registered app slug is accepted.
# AUTH_DEFAULT_AUDIENCE=mod-users
# AUTH_ACCEPTED_AUDIENCES=

# ---- Mailpit / SMTP ---------------------------------------------------------
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=noreply@example.test
MAILPIT_UI_PORT=8025
# SMTP credentials (optional).
# SMTP_USER=
# SMTP_PASS=
# Lifetimes of emailed codes and password-reset links (Go durations).
# EMAIL_CODE_TTL=5m
# PASSWORD_RESET_TTL=30m

# ---- pgAdmin (Postgres web UI, local dev only) ------------------------------
# The pgAdmin container auto-registers the Postgres server via
# deploy/local/pgadmin/servers.json — open the UI, click the "users-module
# (local)" server, type the Postgres password ("users") once. Credentials
# below are for the pgAdmin login itself, not the database.
PGADMIN_DEFAULT_EMAIL=admin@example.test
PGADMIN_DEFAULT_PASSWORD=admin
PGADMIN_UI_PORT=5050

# ---- Timezone (used by Authelia container) -----------------------------------
TZ=UTC

# ---- Field-encryption seed (owned by mod-core) --------------------------------
# CORE_FIELD_KEY_HEX is owned by mod-core, not mod-users. mod-core's
# fieldcrypto.NewFromEnvOrGenerate reads it; the mod-users dev server calls that
# constructor at boot (api/cmd/server/main.go) to build the SSN/EIN field cipher.
# It is a first-boot-only seed: it is consulted only when the field_crypto_keys
# table is empty. On every later boot its value must match the active key
# exactly, or the process fails to start. Do not rotate by editing this value.
# To change the active key, use mod-core's field-crypto-keys rotation route
# (POST /v1/field-crypto-keys/rotations) instead.
# The committed value below is for LOCAL DEVELOPMENT ONLY. It is public in this
# repository, so it must never protect real data. Any shared or production
# environment must generate a fresh value (for example `openssl rand -hex 32`)
# before first boot, because this value seeds the SSN/EIN field-encryption key.
CORE_FIELD_KEY_HEX=f3466598e4a2a22280080f5d53a4b73343e16f1d326f21b81ffec6902b642d28
